
#include "w25q64.h"
#include <stddef.h>


HAL_StatusTypeDef W25Q64_ReadID(
    W25Q64_HandleTypeDef *flash,
    uint8_t id[3]
)
{
    /* Reject invalid input */
    if (flash == NULL ||
        flash->spi == NULL ||
        flash->cs_port == NULL ||
        id == NULL)
    {
        return HAL_ERROR;
    }

    /* 0x9F requests the JEDEC ID */
    uint8_t tx[4] = {0x9F, 0xFF, 0xFF, 0xFF};
    uint8_t rx[4] = {0};

    /* Select the flash chip */
    HAL_GPIO_WritePin(
        flash->cs_port,
        flash->cs_pin,
        GPIO_PIN_RESET
    );

    /* Transmit the command and receive the response */
    HAL_StatusTypeDef result = HAL_SPI_TransmitReceive(
        flash->spi,
        tx,
        rx,
        sizeof(tx),
        100
    );

    /* Always deselect after the transaction */
    HAL_GPIO_WritePin(
        flash->cs_port,
        flash->cs_pin,
        GPIO_PIN_SET
    );

    /* Stop if the SPI transfer failed */
    if (result != HAL_OK)
    {
        return result;
    }

    /* The first received byte is not part of the ID */
    id[0] = rx[1];
    id[1] = rx[2];
    id[2] = rx[3];

    return HAL_OK;
}


HAL_StatusTypeDef W25Q64_ReadStatus(
    W25Q64_HandleTypeDef *flash,
    uint8_t *status
)
{
    if (flash == NULL ||
        flash->spi == NULL ||
        flash->cs_port == NULL ||
        status == NULL)
    {
        return HAL_ERROR;
    }

    /* 0x05 reads Status Register-1 */
    uint8_t tx[2] = {0x05, 0xFF};
    uint8_t rx[2] = {0};

    HAL_GPIO_WritePin(
        flash->cs_port,
        flash->cs_pin,
        GPIO_PIN_RESET
    );

    HAL_StatusTypeDef result = HAL_SPI_TransmitReceive(
        flash->spi,
        tx,
        rx,
        sizeof(tx),
        100
    );

    HAL_GPIO_WritePin(
        flash->cs_port,
        flash->cs_pin,
        GPIO_PIN_SET
    );

    if (result != HAL_OK)
    {
        return result;
    }

    /* Copy the received status byte to the caller's variable */
    *status = rx[1];

    return HAL_OK;
}


HAL_StatusTypeDef W25Q64_WaitReady(
    W25Q64_HandleTypeDef *flash,
    uint32_t timeout_ms
)
{
    if (flash == NULL)
    {
        return HAL_ERROR;
    }

    /* Record the starting time */
    uint32_t start_time = HAL_GetTick();

    while (1)
    {
        uint8_t status_register = 0;

        HAL_StatusTypeDef result =
            W25Q64_ReadStatus(flash, &status_register);

        if (result != HAL_OK)
        {
            return result;
        }

        /* Bit 0 is the BUSY bit */
        if ((status_register & 0x01U) == 0U)
        {
            return HAL_OK;
        }

        /* Has the timeout expired? */
        if ((HAL_GetTick() - start_time) >= timeout_ms)
        {
            return HAL_TIMEOUT;
        }

        /* Wait briefly before polling again */
        HAL_Delay(1);
    }
}
