
#ifndef W25Q64_H
#define W25Q64_H

#include "stm32f4xx_hal.h"

/* Information required to communicate with one flash chip */
typedef struct
{
    SPI_HandleTypeDef *spi;
    GPIO_TypeDef *cs_port;
    uint16_t cs_pin;

} W25Q64_HandleTypeDef;


/* Read the three identification bytes */
HAL_StatusTypeDef W25Q64_ReadID(
    W25Q64_HandleTypeDef *flash,
    uint8_t id[3]
);

/* Read Status Register-1 */
HAL_StatusTypeDef W25Q64_ReadStatus(
    W25Q64_HandleTypeDef *flash,
    uint8_t *status
);

/* Wait until the flash is ready or the timeout expires */
HAL_StatusTypeDef W25Q64_WaitReady(
    W25Q64_HandleTypeDef *flash,
    uint32_t timeout_ms
);

#endif
