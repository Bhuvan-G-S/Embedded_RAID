#include "w25q64.h"

HAL_StatusTypeDef W25Q64_ReadID(
    W25Q64_HandleTypeDef *flash,
    uint8_t id[3]
)
{
    uint8_t tx[4] = {0x9F, 0xFF, 0xFF, 0xFF};
    uint8_t rx[4] = {0};

    HAL_GPIO_WritePin(
        flash->cs_port,
        flash->cs_pin,
        GPIO_PIN_RESET
    );

    HAL_StatusTypeDef result = HAL_SPI_TransmitReceive(
        flash->spi,
        tx,
        rx,
        sizeof(tx),
        100
    );

    HAL_GPIO_WritePin(
        flash->cs_port,
        flash->cs_pin,
        GPIO_PIN_SET
    );

    if (result != HAL_OK)
    {
        return result;
    }

    id[0] = rx[1];
    id[1] = rx[2];
    id[2] = rx[3];

    return HAL_OK;

    HAL_StatusTypeDef W25Q64_ReadStatus(
        W25Q64_HandleTypeDef *flash,
        uint8_t *status_byte
    )
    {
        /* Command to read Status Register-1 */
        uint8_t tx[2] = {0x05, 0xFF};

        /* Space for received bytes */
        uint8_t rx[2] = {0};

        /* Select the flash */
        HAL_GPIO_WritePin(
            flash->cs_port,
            flash->cs_pin,
            GPIO_PIN_RESET
        );

        /* Exchange two bytes over SPI */
        HAL_StatusTypeDef result = HAL_SPI_TransmitReceive(
            flash->spi,
            tx,
            rx,
            sizeof(tx),
            100
        );

        /* End the transaction */
        HAL_GPIO_WritePin(
            flash->cs_port,
            flash->cs_pin,
            GPIO_PIN_SET
        );

        /* Stop if SPI failed */
        if (result != HAL_OK)
        {
            return result;
        }

        /* Store the actual flash status byte */
        *status_byte = rx[1];

        return HAL_OK;
    }

}
